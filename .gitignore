.DS_Store

# Dependencies
node_modules/
**/node_modules/

# Environment and secrets
.env
.env.*
!.env.example
!.env.deploy.example
backend/.env
frontend/.env

# Build outputs
dist/
build/
coverage/
.cache/
frontend/dist/
backend/dist/
backend/storage/

# TypeScript/Node generated artifacts accidentally emitted next to sources
backend/prisma.config.js
backend/prisma.config.js.map
backend/prisma.config.d.ts
backend/prisma.config.d.ts.map
backend/src/**/*.js
backend/src/**/*.js.map
backend/src/**/*.d.ts
backend/src/**/*.d.ts.map

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local editor files
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
