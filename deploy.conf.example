REPO_URL='https://github.com/megabytecode/expense-tracker.git'
DEPLOY_PATH='.'
COMPOSE_FILE='compose.yaml'
ENV_FILE='/srv/secrets/expense-tracker/app.env'
COMPOSE_PROJECT_NAME='expense-tracker'
HEALTHCHECK_URL='http://127.0.0.1:3101/health'
RELEASES_TO_KEEP='5'
REMOTE_BRANCH='production'
MIGRATION_COMMAND='docker compose --env-file /srv/secrets/expense-tracker/app.env -f compose.yaml run --build --rm app npm --prefix /app/backend run prisma:migrate:deploy'
